# ---------------------------------------------------------------------------
# Boundary11 environment configuration
# Copy this file to `.env` at the repo root and fill in real values.
# NEVER commit a real `.env` file. NEVER commit secrets.
# ---------------------------------------------------------------------------

# --- Server (server-only; never exposed to the browser) ---
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Canonical URLs used in server-side responses/logging.
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:5000/api/v1

# --- Supabase (server-only). Leave blank to run in LOCAL/DUrable DEMO mode. ---
# When these are blank/empty the API runs on the durable local provider
# (server/.data/boundary11.local.json). Fill them in to use Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY: server-only, full database access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data / auth provider selection ---
# auto | local | supabase | demo
#   auto      → supabase when configured above, otherwise local
#   local     → durable single-process file store (server/.data)
#   supabase  → Postgres via PostgREST; falls back to local if Supabase
#               credentials are missing
#   demo      → in-memory prototype data (resets on restart)
# The test suite always uses 'demo' unless it requests 'local' explicitly.
DATA_PROVIDER=auto
AUTH_PROVIDER=auto
# Only honoured for DATA_PROVIDER=local. Defaults to server/.data.
LOCAL_DATA_DIR=

# --- Frontend (Vite). Only VITE_* variables are exposed to the browser. ---
# These must NEVER contain secrets.
VITE_API_URL=http://localhost:5000/api/v1
VITE_STOREFRONT_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# --- Demo/mock auth (prototype only) ---
# Changing this invalidates previously issued demo tokens.
DEMO_AUTH_SECRET=boundary11-demo-secret-change-me